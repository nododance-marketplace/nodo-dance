{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nodo-dance.vercel.app" }],
      "destination": "https://nododance.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/atlas/tick",
      "schedule": "0 6 * * *"
    }
  ]
}
