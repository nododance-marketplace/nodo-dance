# Database (Neon Postgres — pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/nododance?sslmode=require"
# Direct (non-pooled) connection, required by `prisma db push`
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/nododance?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://nododance.com"

# Email (SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Nodo Dance <noreply@nododance.com>"

# Google OAuth (optional — magic link works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (event images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin Access (comma-separated list of admin emails)
ADMIN_EMAILS="admin@example.com,you@example.com"

# App Config
NEXT_PUBLIC_APP_URL="https://nododance.com"
NEXT_PUBLIC_CITY="Charlotte, NC"

# Public submission rate limiting (set to "false" to disable in development)
EVENT_RATE_LIMIT_ENABLED="true"

# ─────────────────────────────────────────────────────────────
# NODO ATLAS — ingestion engine
# ─────────────────────────────────────────────────────────────
# Shared secret for the scheduler endpoint. /api/atlas/tick refuses to run
# without it, so the cron can never be triggered from the public internet.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# How many sources one scheduler run may crawl. The run is bounded so it
# finishes inside the serverless timeout. Keep it modest: a crawl of ten
# sources takes about a minute.
ATLAS_MAX_SOURCES="10"

# Keyword discovery via Serper (optional). Sitemaps work without it.
SERPER_API_KEY=""

# Local proof-of-concept database (SQLite) — never points at production
ATLAS_DATABASE_URL="file:./atlas.db"
